<Window x:Class="Zhengxin.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="正心Translate" Width="1080" Height="800" MinWidth="980" MinHeight="720">
<DockPanel><Menu DockPanel.Dock="Top"><MenuItem Header="任务"><MenuItem Header="开始翻译" Click="StartMenu" InputGestureText="Ctrl+Enter"/><MenuItem Header="暂停／继续" Click="PauseClick"/><MenuItem Header="取消任务" Click="CancelMenu"/></MenuItem><MenuItem Header="设置" Click="SettingsClick"/><MenuItem Header="帮助"><MenuItem Header="正心Translate 帮助" Click="HelpClick"/><MenuItem Header="访问官网" Click="WebsiteClick"/><MenuItem Header="获取更新与支持" Click="UpdatesClick"/><MenuItem Header="反馈问题" Click="FeedbackClick"/><Separator/><MenuItem Header="关于正心Translate" Click="AboutClick"/></MenuItem></Menu>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="34">
<TextBlock Text="整书翻译" FontSize="30" FontWeight="Bold"/><TextBlock Text="基于 TranslateGemma 4B 与 BookForge 进行本地整书翻译" FontSize="15" Foreground="#5C6E80" Margin="0,8,0,18"/>
<TextBlock x:Name="EnvironmentLabel" Text="正在准备运行环境…" Foreground="#5C6E80" Margin="0,0,0,12"/>
<StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button x:Name="VerifyButton" Content="验证本地模型" Click="VerifyClick"/><Button x:Name="RetryButton" Content="重试环境准备" Click="RetryClick" Visibility="Collapsed"/></StackPanel>
<Grid x:Name="OptionsGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/></Grid.RowDefinitions>
<TextBlock Text="输入文件" VerticalAlignment="Center" FontWeight="SemiBold"/><Border Grid.Column="1" Background="White" BorderBrush="#7AC7AB61" BorderThickness="1" CornerRadius="8" Margin="0,5"><DockPanel><Button DockPanel.Dock="Right"  ToolTip="选择输入文件" AutomationProperties.Name="选择输入文件" Click="InputClick" Padding="8,0" Margin="0" Style="{StaticResource PathSearchButton}"><Viewbox Width="14" Height="14"><Path Data="M30.25,31.48h-.55c-.43-.11-.71-.37-1.03-.7l-6.74-6.74c-4.01,3.19-9.45,3.88-14.2,1.64C3.51,23.69.47,19.46.08,14.62l-.05-.22.02-1.75C.57,5.21,6.88-.36,14.3.05c4.91.27,9.25,3.28,11.32,7.55,2.29,4.73,1.66,10.23-1.58,14.31l6.96,6.96c.44.44.6,1,.4,1.6-.16.48-.6.88-1.14,1ZM23.99,13.51c0-5.79-4.69-10.48-10.48-10.48S3.03,7.72,3.03,13.51s4.69,10.48,10.48,10.48,10.48-4.69,10.48-10.48Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox></Button><TextBlock x:Name="InputPath" Text="EPUB、文本型 PDF、DOCX、TXT 或 MD" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
<TextBlock Grid.Row="1" Text="输出目录" VerticalAlignment="Center" FontWeight="SemiBold"/><Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#7AC7AB61" BorderThickness="1" CornerRadius="8" Margin="0,5"><DockPanel><Button DockPanel.Dock="Right"  ToolTip="选择输出目录" AutomationProperties.Name="选择输出目录" Click="OutputClick" Padding="8,0" Margin="0" Style="{StaticResource PathSearchButton}"><Viewbox Width="14" Height="14"><Path Data="M30.25,31.48h-.55c-.43-.11-.71-.37-1.03-.7l-6.74-6.74c-4.01,3.19-9.45,3.88-14.2,1.64C3.51,23.69.47,19.46.08,14.62l-.05-.22.02-1.75C.57,5.21,6.88-.36,14.3.05c4.91.27,9.25,3.28,11.32,7.55,2.29,4.73,1.66,10.23-1.58,14.31l6.96,6.96c.44.44.6,1,.4,1.6-.16.48-.6.88-1.14,1ZM23.99,13.51c0-5.79-4.69-10.48-10.48-10.48S3.03,7.72,3.03,13.51s4.69,10.48,10.48,10.48,10.48-4.69,10.48-10.48Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Viewbox></Button><TextBlock x:Name="OutputPath" Text="翻译结果保存位置" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
<TextBlock Grid.Row="2" Text="翻译语言" VerticalAlignment="Center" FontWeight="SemiBold"/><Grid Grid.Row="2" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SourceButton" Content="自动检测 ▾" Click="SourceClick" Foreground="#293B4D" Background="White" Padding="10,5"/><Button Grid.Column="1" Content="⇄" Click="SwapClick" Background="Transparent" Foreground="#293B4D" Padding="0"/><Button x:Name="TargetButton" Grid.Column="2" Content="简体中文（zh-CN） ▾" Click="TargetClick" Foreground="#293B4D" Background="White" Padding="10,5"/></Grid>
<TextBlock Grid.Row="3" Text="输出格式" VerticalAlignment="Center" FontWeight="SemiBold"/><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="Format" SelectedIndex="0" Width="230"><ComboBoxItem Content="Word (.docx)"/><ComboBoxItem Content="Markdown (.md)"/></ComboBox><TextBlock Text="统一输出为可继续校订的 Word 或 Markdown。" FontSize="12" Margin="12,0" VerticalAlignment="Center"/></StackPanel>
<TextBlock Grid.Row="4" Text="输出模式" VerticalAlignment="Center" FontWeight="SemiBold"/><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="OnlyTranslation" Content="仅译文" IsChecked="True" Margin="0,0,30,0"/><RadioButton x:Name="Bilingual" Content="双语对照"/></StackPanel>
</Grid>
<WrapPanel Margin="0,18,0,18"><Button x:Name="StartButton" Content="开始翻译" Click="StartClick" IsEnabled="False" Width="132"/><Button x:Name="PauseButton" Content="暂停" Click="PauseClick" IsEnabled="False" Width="88"/><Button Content="术语建议" Click="GlossaryClick" Width="108"/><Button Content="检查列表" Click="ReviewClick" Width="108"/><Button x:Name="ResultButton" Content="打开结果" Click="ResultClick" IsEnabled="False" Width="108"/></WrapPanel>
<ProgressBar x:Name="Progress" Height="6" Maximum="1" Foreground="#C7AB61"/><DockPanel Margin="0,8,0,18"><TextBlock x:Name="Position" DockPanel.Dock="Right"/><TextBlock x:Name="Status" Text="尚未提交任务"/></DockPanel>
<TextBlock Text="任务日志" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="Logs" Height="180" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="White" BorderBrush="#14000000" Padding="12"/>
</StackPanel></ScrollViewer></DockPanel></Window>
